:80 {
    root * /usr/share/caddy

    # API → mai cachare
    @api path /api/*
    header @api Cache-Control "no-cache, no-store, must-revalidate"
    header @api Pragma "no-cache"

    reverse_proxy /api/* glancepms-backend:8080

    # Assets con hash → cache permanente (Vite li rinnova ad ogni build)
    @hashedAssets path /assets/*
    header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

    # index.html → sempre fresco
    @noCache path /index.html
    header @noCache Cache-Control "no-cache, no-store, must-revalidate"

    file_server
    try_files {path} /index.html
}
